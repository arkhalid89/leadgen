# ==========================================
# LeadGen configuration
# Copy to .env and fill in. Never commit .env.
# ==========================================

# --- Core ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LEADGEN_SECRET_KEY=change-me-to-a-random-64-char-hex-string
LEADGEN_DB_PATH=leadgen.db
LEADGEN_OUTPUT_DIR=output
LEADGEN_ENV=development
# Comma-separated origins allowed to call the API (the Next.js app).
LEADGEN_ALLOWED_ORIGINS=http://localhost:3600,http://localhost:3000

# --- Email discovery (free, no API key) -------------------------------------
# Emails are read from each business's own website. No model is involved: a
# language model with no live web access can only invent contact details.
LEADGEN_EMAIL_CONCURRENCY=25
LEADGEN_EMAIL_TIMEOUT=8
# Homepage plus this many follow-up pages (contact, about, impressum, team...).
LEADGEN_EMAIL_MAX_PAGES=4
# Cache answers by domain so a site is fetched once, ever.
LEADGEN_EMAIL_USE_CACHE=1
# When a business's own site yields nothing, look it up by name in a search
# engine: it often knows the contact page, and sometimes shows the address.
# Only addresses that plausibly belong to that business are kept.
LEADGEN_EMAIL_SEARCH_FALLBACK=1
LEADGEN_EMAIL_SEARCH_MAX_LOOKUPS=150
LEADGEN_EMAIL_SEARCH_CONCURRENCY=3

# --- Gemini (OPTIONAL - outreach copy only) ---------------------------------
# Used only to draft cold emails, which is generative and has no ground truth
# to get wrong. Leave blank to use the built-in templates instead.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Google Maps scraping ---
# Concurrent tabs reading listing detail pages. Under Playwright these are
# tabs in one browser, not separate Chrome processes, so this can go higher
# than it could with Selenium for the same memory.
LEADGEN_GMAPS_DETAIL_WORKERS=8
# Detail results are written back every N businesses, so stopping mid-phase
# keeps the phone numbers already gathered.
LEADGEN_GMAPS_DETAIL_BATCH=20
LEADGEN_GMAPS_HEADLESS=1
LEADGEN_GMAPS_SCROLL_ROUNDS=40
# One Maps search returns ~100-120 results however far you scroll. Above the
# yield below, the area is geocoded and searched tile by tile to get past it.
LEADGEN_GMAPS_TILING=1
LEADGEN_GMAPS_SINGLE_SEARCH_YIELD=90
LEADGEN_GMAPS_MAX_CELLS=25
LEADGEN_GMAPS_CELL_ZOOM=15
# Unlimited searches: a cell returning at least this many new results is assumed
# to be hiding more behind Maps' cap, so it is split into four and searched again.
LEADGEN_GMAPS_SATURATION=45
LEADGEN_GMAPS_MAX_DEPTH=3
# Ceiling on searches for one run, so an unlimited run still ends.
LEADGEN_GMAPS_MAX_SEARCHES=400
# Normally unset: Playwright downloads and manages its own Chromium, matched
# to the driver version. Set only to force a specific build.
# CHROME_BIN=/usr/bin/chromium

# --- Web search ---
# Optional. Without it, DuckDuckGo is used (free, no key).
# With it, real Google results via https://serper.dev
SERPER_API_KEY=
LEADGEN_SEARCH_MAX_QUERIES=8
LEADGEN_SEARCH_RESULTS_PER_QUERY=40

# --- Limits ---
LEADGEN_MAX_ACTIVE_JOBS_PER_USER=3

# --- AI email suggestions (OPT-IN, measured 30% precision) -------------------
# Used only by the "Find missing emails" button when you tick the AI box.
# Results are stored flagged unverified and never overwrite a scraped address.
LEADGEN_AI_EMAIL_BATCH_SIZE=20
LEADGEN_AI_EMAIL_CONCURRENCY=3
# One longer retry for slow/overloaded hosting before giving up on a site.
LEADGEN_EMAIL_SLOW_RETRY_TIMEOUT=20

# --- SMTP verification (recommended) ----------------------------------------
# Asks each domain's mail server whether a mailbox exists, and tests common
# addresses (contact@, hr@, help@...) for businesses that publish none.
# No mail is ever sent - the session stops before DATA.
# Needs outbound port 25; some networks and AWS/GCP block it by default.
LEADGEN_SMTP_VERIFY=0
# Identify honestly with a domain you control. Mail servers check these, and a
# bogus HELO is a fast route to being rate-limited or blacklisted.
LEADGEN_SMTP_HELO_HOST=localhost
LEADGEN_SMTP_MAIL_FROM=verify@localhost
# Keep concurrency low and the delay non-zero: polite probing stays unblocked.
LEADGEN_SMTP_CONCURRENCY=4
LEADGEN_SMTP_PROBE_DELAY=0.4
LEADGEN_SMTP_MAX_CANDIDATES=12
# Override the role mailboxes tried, e.g. "info,contact,hr,help,sales"
LEADGEN_SMTP_PATTERNS=
